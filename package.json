{
	"name": "portfolio",
	"private": true,
	"version": "1.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"lighthouse": "lhci autorun",
		"preview": "vite preview",
		"vercel-build": "vite build",
		"changelog:check": "grep -q \"$(cat package.json | grep '\"version\"' | cut -d'\"' -f4)\" CHANGELOG.md || (echo '❌ Version not found in CHANGELOG.md' && exit 1)",
		"release:check": "npm run test:run && npm run lint && npm run changelog:check && echo '✅ Ready for release'",
		"version:sync": "node -e \"const pkg=require('./package.json'); console.log('Package:', pkg.version); console.log('CHANGELOG:'); require('fs').readFileSync('CHANGELOG.md', 'utf8').split('\\n').filter(l=>l.startsWith('## [')).slice(0,3).forEach(l=>console.log(l))\""
	},
	"dependencies": {
		"@studio-freight/lenis": "^1.0.42",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@vercel/analytics": "^1.5.0",
		"framer-motion": "^12.6.2",
		"i18next": "^25.5.1",
		"i18next-browser-languagedetector": "^8.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-i18next": "^15.7.3",
		"react-icons": "^5.5.0",
		"react-router-dom": "^7.8.2",
		"react-scroll-parallax": "^3.4.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@eslint/js": "^9.21.0",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.55.0",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22.14.0",
		"@types/react": "^19.0.12",
		"@types/react-dom": "^19.0.4",
		"@typescript-eslint/eslint-plugin": "^8.41.0",
		"@typescript-eslint/parser": "^8.41.0",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.21.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"globals": "^15.15.0",
		"jiti": "^2.5.1",
		"jsdom": "^26.1.0",
		"postcss": "^8.5.3",
		"rollup-plugin-visualizer": "^6.0.3",
		"tailwindcss": "^3.3.5",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.2",
		"vite": "^5.2.8",
		"vite-plugin-svgr": "^4.3.0",
		"vitest": "^3.2.4"
	}
}
